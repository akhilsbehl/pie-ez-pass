{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/akhilsbehl/pie-ez-pass/refs/heads/master/schemas/config.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "enum": [
        "sys1",
        "sys2"
      ]
    },
    "sys1_provider": {
      "default": "openrouter",
      "type": "string",
      "minLength": 1
    },
    "sys1_model": {
      "default": "typesafe/jev-1.13",
      "type": "string",
      "minLength": 1
    },
    "sys2_provider": {
      "default": "openai-codex",
      "type": "string",
      "minLength": 1
    },
    "sys2_model": {
      "default": "codex-auto-review",
      "type": "string",
      "minLength": 1
    },
    "sys2_reasoning": {
      "default": "low",
      "type": "string",
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "timeoutMs": {
      "default": 30000,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 300000
    },
    "additionalPolicy": {
      "type": "string",
      "minLength": 1
    },
    "sys1_escalate_threshold": {
      "default": 0.6,
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rules": {
      "default": {
        "allow": {
          "commands": [],
          "paths": []
        },
        "block": {
          "commands": [],
          "paths": []
        }
      },
      "type": "object",
      "properties": {
        "allow": {
          "default": {
            "commands": [],
            "paths": []
          },
          "type": "object",
          "properties": {
            "commands": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "paths": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "block": {
          "default": {
            "commands": [],
            "paths": []
          },
          "type": "object",
          "properties": {
            "commands": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "paths": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "reviewer"
  ],
  "additionalProperties": false
}
