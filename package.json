{
  "name": "pie-permission-auto-review-codex",
  "version": "0.1.4",
  "description": "Standalone Codex-style permissions for Pi coding agent tool calls",
  "keywords": [
    "authorizer",
    "auto-review",
    "codex",
    "permissions",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/akhilsbehl/pie-permission-auto-review-codex#readme",
  "bugs": {
    "url": "https://github.com/akhilsbehl/pie-permission-auto-review-codex/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Akhil Behl"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akhilsbehl/pie-permission-auto-review-codex.git"
  },
  "files": [
    "dist",
    "schemas",
    "config/config.example.json",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/pie-permission-auto-review-codex.mjs",
  "types": "./dist/pie-permission-auto-review-codex.d.mts",
  "exports": {
    ".": {
      "types": "./dist/pie-permission-auto-review-codex.d.mts",
      "import": "./dist/pie-permission-auto-review-codex.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.80.10",
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@types/node": "26.1.1",
    "tsdown": "0.22.13",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "@earendil-works/pi-tui": "0.80.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.80.10 || ^0.81.0",
    "@earendil-works/pi-coding-agent": "^0.80.10 || ^0.81.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./dist/pie-permission-auto-review-codex.mjs"
    ]
  },
  "scripts": {
    "build": "tsdown --clean && mv dist/index.mjs dist/pie-permission-auto-review-codex.mjs && mv dist/index.d.mts dist/pie-permission-auto-review-codex.d.mts && sed -i 's/[[:space:]]*$//' dist/pie-permission-auto-review-codex.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:schema": "node --experimental-strip-types scripts/generate-schema.ts"
  },
  "contributors": [
    {
      "name": "mzwing",
      "email": "mzwing@mzwing.eu.org"
    }
  ]
}
